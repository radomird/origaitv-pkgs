# The public key OrigaiTV's packages, release.json and tested.json are signed
# with, for pacman's keyring, the way omarchy-keyring carries Omarchy's. Bump
# pkgver when the key changes, and list a retired key in origaitv-revoked.

pkgname=origaitv-keyring
pkgver=20261022
pkgrel=1
pkgdesc="The key OrigaiTV's packages are signed with"
arch=(any)
license=(MIT)
options=(!debug)
install=origaitv-keyring.install
source=(origaitv.gpg origaitv-trusted origaitv-revoked)
sha256sums=(
  '2c8f52fbdae90082f83808b4ca2d16748d79e81521b1002d8a68ff4528b4cc92'  # origaitv.gpg
  '24433c9bb618a68b90a0d21ac82e0c45ebc7c6b79d060ea989a0896d19f0752c'  # origaitv-trusted
  'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'  # origaitv-revoked
)

package() {
  install -Dm644 -t "$pkgdir/usr/share/pacman/keyrings/" origaitv.gpg origaitv-trusted origaitv-revoked
}
