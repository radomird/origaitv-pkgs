#!/bin/bash

# Says which of origaitv-os's release notes a build shows as What's new.
#
# A release shows its own: release-notes/1.0.0.txt for 1.0.0. An edge
# build, which a candidate's ISO carries too, has a version like
# 1.0.0rc6.r3.gabc1234 or 1.0.0.r3.gabc1234 and no notes of its own, so it
# shows the notes of the release it leads to: the first
# release-notes/<version>.txt after what it counts from. For
# 1.0.0rc6.r3.gabc1234 that's 1.0.0's, and for 1.0.0.r3.gabc1234 it's
# 1.0.1's once they're written.
#
# Prints "own <file>" or "borrowed <file>", or nothing when there are no
# notes for it. Borrowed notes never bring a release's security mark with
# them (bin/build).
#
# Usage: bin/release-notes <release-notes dir> <version>

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
dir=${1:?usage: bin/release-notes <release-notes dir> <version>}
version=${2:?usage: bin/release-notes <release-notes dir> <version>}

if [[ -f $dir/$version.txt ]]; then
  echo "own $dir/$version.txt"
  exit 0
fi
[[ $version == *.r* ]] || exit 0

base=${version%%.r*}
next=$(find "$dir" -maxdepth 1 -name '*.txt' -printf '%f\n' 2>/dev/null | sed 's/\.txt$//' | { cat; echo "$base"; } |
  "$ROOT/bin/version-sort" -u | awk -v base="$base" 'found { print; exit } $0 == base { found = 1 }')
[[ -z $next ]] || echo "borrowed $dir/$next.txt"
